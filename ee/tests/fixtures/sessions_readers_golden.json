    "id": "default-crew-files",
    "kind": "allow",
    "reason": "A station keeps its reports, settings and worktrees in the crew's own folders.",
    "role": "all",
    "source": "default",
    "text": "Creating and editing files under {home} (the crew's own folder), and git worktrees under the .factory/worktrees folder of {wt_repos} or under {home}/worktrees, is expected work for this crew station."
   },
   {
    "id": "default-crew-tidy",
    "kind": "allow",
    "reason": "Tidy refuses anything outside the crew's folders, so a station can clean up after itself.",
    "role": "all",
    "source": "default",
    "text": "Removing git worktrees and scratch folders with `tares factory tidy <path>`, which deletes only inside the crew's own folders, is expected work for this crew station."
   },
   {
    "id": "default-crew-records",
    "kind": "allow",
    "reason": "The plan, the tickets and the desk live on Tares, and Tares limits each role on its own.",
    "role": "all",
    "source": "default",
    "text": "Reading and writing this crew's records on Tares at {tares} through the Tares MCP tools (tickets, stages, checks, reviews, assumptions, the desk) is expected work for this crew station, within what Tares allows its role."
   },
   {
    "id": "default-orchestrator-sessions",
    "kind": "allow",
    "reason": "The orchestrator runs the crew's stations; the person agreed to that by starting the crew.",
    "role": "orchestrator",
    "source": "default",
    "text": "Starting background Claude Code sessions for this crew with `tares factory spawn` (builders named `<project>-build-<slug>` inside a project's repo, helpers named `<station>-<slug>`), and stopping, removing or resuming the sessions recorded in {stations_file} with `tares factory retire`, `tares factory revive`, `tares factory restart`, `claude stop`, `claude rm` or `claude --bg --resume`, is expected work that {human} authorized by running `tares factory crew up`. Sessions not recorded there are out of scope."
   },
   {
    "id": "default-builder-push",
    "kind": "allow",
    "reason": "A builder delivers its tickets as pull requests; Tares merges them, never the builder.",
    "role": "builder",
    "source": "default",
    "text": "Pushing `factory/*` branches to {where}, and opening pull requests there, is expected work that {human} authorized."
   },
   {
    "id": "default-reviewer-verdicts",
    "kind": "allow",
    "reason": "The reviewer's verdict is a comment and a commit status; the merge gate reads them.",
    "role": "reviewer",
    "source": "default",
    "text": "Posting review-verdict comments with `gh pr comment` on pull requests that this crew opened in {repos}, and setting the `factory/review` commit status on their head commits with `gh api repos/.../statuses/<sha>`, is expected work that {human} authorized."
   },
   {
    "id": "default-releaser-release",
    "kind": "allow",
    "reason": "The releaser ships what was merged, in the local cluster only.",
    "role": "releaser",
    "source": "default",
    "text": "Building container images, loading them into the local kind cluster `{cluster}`, applying manifests, rolling out and rolling back in that cluster, creating `v*` git tags and GitHub releases in {repos}, are expected work that {human} authorized."
   },
   {
    "id": "default-production",
    "kind": "deny",
    "reason": "Production is the person's call, never a station's.",
    "role": "all",
    "source": "default",
    "text": "Deploying to, or changing, any environment, kube context or namespace whose name matches the pattern {prod_pattern}. That needs {human} directly."
   }
