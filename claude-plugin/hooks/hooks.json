{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "tares hook ship", "timeout": 10}]},
      {"hooks": [{"type": "command", "command": "tares hook session-start", "timeout": 5}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash|mcp__.*", "hooks": [{"type": "command", "command": "tares hook guard", "timeout": 5}]},
      {"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "tares hook ship", "async": true}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "tares hook ship", "async": true}]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "tares hook ship", "async": true}]},
      {"matcher": "Bash|ExitPlanMode", "hooks": [{"type": "command", "command": "tares hook challenger", "timeout": 900}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "tares hook challenger", "timeout": 10}]},
      {"hooks": [{"type": "command", "command": "tares hook ship", "async": true}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "tares hook ship", "async": true}]}
    ],
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "tares hook ship", "async": true}]}
    ],
    "Notification": [
      {"hooks": [{"type": "command", "command": "tares hook ship", "async": true}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "tares hook ship"}]}
    ]
  }
}
