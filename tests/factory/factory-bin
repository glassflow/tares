#!/bin/sh
# Runs the factory CLI under test as the command in $FACTORY_BIN, one or more words ("tares factory").
# The suites run "$F" with $F set to this file when FACTORY_BIN is set, so every call stays quoted and a
# two-word command works; with FACTORY_BIN unset they run the bash script directly, as they always did.
exec $FACTORY_BIN "$@"
