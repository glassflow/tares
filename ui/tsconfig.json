{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@paper-kit/*": ["./paper-kit/src/*"], "@paper-kit": ["./paper-kit/src/index.ts"] }
  },
  "include": ["src", "paper-kit/src"]
}
